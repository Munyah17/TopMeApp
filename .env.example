# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
# Personal access token — only needed locally to push schema.sql/seed.sql via the
# Supabase Management API. Never used at runtime by the app itself.
SUPABASE_ACCESS_TOKEN=your_pat
SUPABASE_PROJECT_REF=your_project_ref

# Secret used to encrypt API module keys (api_modules.key_encrypted) at rest.
# Generate with: openssl rand -hex 32
API_ENCRYPTION_KEY=

# Paynow Zimbabwe
PAYNOW_INTEGRATION_ID=your_integration_id
PAYNOW_INTEGRATION_KEY=your_integration_key
PAYNOW_RESULT_URL=https://yourapp.com/api/wallet/topup/paynow/callback
PAYNOW_RETURN_URL=https://yourapp.com/wallet

# Stripe
STRIPE_SECRET_KEY=sk_live_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# EcoCash Instant USSD — confirm exact field/endpoint names against your
# merchant onboarding pack before going live (see src/lib/payments/ecocash.ts)
ECOCASH_MERCHANT_CODE=
ECOCASH_API_KEY=
ECOCASH_BASE_URL=https://api.ecocash.co.zw/v2/payment/instant

# VitalPay (Tayari / KMG Vital Links) — biller aggregator. Use sk_live_/
# pk_live_ keys in production — sk_test_/pk_test_ authenticate fine but
# never push a real recharge.
VITALPAY_BASE_URL=https://kmgvitallinks.co.uk/api/v1
VITALPAY_PUBLIC_KEY=pk_live_...
VITALPAY_SECRET_KEY=sk_live_...
# Two webhook endpoints can be registered against the same route (real
# domain + a fallback), each returned once by POST /webhooks when you
# register it (only possible once deployed to a public HTTPS URL).
VITALPAY_WEBHOOK_SECRET=
VITALPAY_WEBHOOK_SECRET_FALLBACK=

# Email notifications (SMTP) — sent for payment receipts, wallet top-ups and
# gift vouchers (see src/lib/email). One shared password across every real
# department mailbox listed in SENDER_ADDRESSES (src/lib/email/client.ts).
EMAIL_SMTP_HOST=c3.my-control-panel.com
EMAIL_SMTP_PORT=465
EMAIL_SMTP_SECURE=true
EMAIL_SMTP_PASS=your_shared_mailbox_password

# TariqifyIMS (Motions Microinsurance) — insurance underwriter API
TARIQIFY_BASE_URL=https://portal.motions.co.zw/api/v1
TARIQIFY_API_KEY=tqfy_sk_live_e4df3457c1d833e6ade0d1e15faf8751fc2e7876455a8586
TARIQIFY_PUBLISHABLE_KEY=tqfy_pk_live_d9c6fe228a6ccff2e8967729

# Cron job secret for scheduled tasks
CRON_SECRET=your_random_cron_secret_here

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=TopMe
