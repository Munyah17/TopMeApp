# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
# Personal access token — only needed locally to push schema.sql/seed.sql via the
# Supabase Management API. Never used at runtime by the app itself.
SUPABASE_ACCESS_TOKEN=your_pat
SUPABASE_PROJECT_REF=your_project_ref

# Secret used to encrypt API module keys (api_modules.key_encrypted) at rest.
# Generate with: openssl rand -hex 32
API_ENCRYPTION_KEY=

# Paynow Zimbabwe
PAYNOW_INTEGRATION_ID=your_integration_id
PAYNOW_INTEGRATION_KEY=your_integration_key
PAYNOW_RESULT_URL=https://yourapp.com/api/wallet/topup/paynow/callback
PAYNOW_RETURN_URL=https://yourapp.com/wallet

# Stripe
STRIPE_SECRET_KEY=sk_live_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# EcoCash Instant USSD — confirm exact field/endpoint names against your
# merchant onboarding pack before going live (see src/lib/payments/ecocash.ts)
ECOCASH_MERCHANT_CODE=
ECOCASH_API_KEY=
ECOCASH_BASE_URL=https://api.ecocash.co.zw/v2/payment/instant

# VitalPay (Tayari / KMG Vital Links) — biller aggregator, wire in when ready
VITALPAY_API_KEY=
VITALPAY_MERCHANT_ID=
VITALPAY_BASE_URL=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=TopMe
